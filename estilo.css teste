* { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Poppins', sans-serif; }
html { font-size: 14px; }
body { 
    background-color: #f8f9fa; 
    padding-bottom: 95px; 
    line-height: 1.4; 
    overflow-x: hidden; 
}
.oculto { display: none !important; }

@media (min-width: 768px) {
    body { max-width: 620px; margin: 0 auto; }
}

/* ===== CABEÇALHO ===== */
.cabecalho-loja {
    width: 100%;
    padding: 12px 15px;
    background: #fff;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid #eee;
    position: sticky;
    top: 0;
    z-index: 90;
}

.status-loja {
    padding: 6px 12px;
    border-radius: 20px;
    font-size: 13px;
    font-weight: 600;
}
.status-aberto { background: #dcfce7; color: #166534; }
.status-fechado { background: #fee2e2; color: #991b1b; }

.nome-loja {
    font-size: 18px;
    font-weight: 700;
    color: #222;
}

.btn-ver-pedidos {
    background: transparent;
    color: #222;
    border: 1px solid #ddd;
    padding: 6px 10px;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 500;
    display: flex;
    align-items: center;
    gap: 5px;
    cursor: pointer;
    transition: background 0.2s;
}
.btn-ver-pedidos:hover { background: #f5f5f5; }
.btn-ver-pedidos i { font-size: 15px; }

/* ===== CATEGORIAS ===== */
.categorias { padding: 15px; }
.categorias h2 { font-size: 16px; margin-bottom: 10px; color: #333; }
.lista-categorias { display: flex; gap: 8px; overflow-x: auto; padding-bottom: 5px; }
.btn-categoria {
    border: 1px solid #ddd;
    background: #fff;
    padding: 8px 16px;
    border-radius: 20px;
    cursor: pointer;
    white-space: nowrap;
    font-size: 14px;
}
.btn-categoria.ativo { background: #222; color: #fff; border-color: #222; }

/* ===== PRODUTOS ===== */
.produtos { padding: 0 15px 20px; }
.produto {
    background: #fff;
    border: 1px solid #eee;
    border-radius: 10px;
    padding: 12px;
    margin-bottom: 10px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
}
.info-produto h3 { font-size: 15px; color: #222; margin-bottom: 4px; }
.info-produto p { font-size: 13px; color: #777; margin-bottom: 6px; }
.preco-produto { font-size: 16px; font-weight: 700; color: #16a34a; }

/* ===== BOTÕES FIXOS ===== */
.btn-carrinho {
    position: fixed;
    bottom: 20px;
    right: 20px;
    width: 55px;
    height: 55px;
    border-radius: 50%;
    background: #222;
    color: #fff;
    border: none;
    font-size: 22px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 99;
}
#qtd-carrinho {
    position: absolute;
    top: -5px;
    right: -5px;
    background: #ef4444;
    color: #fff;
    font-size: 12px;
    font-weight: 700;
    min-width: 20px;
    height: 20px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
}

.btn-whatsapp {
    position: fixed;
    bottom: 90px;
    right: 20px;
    width: 55px;
    height: 55px;
    border-radius: 50%;
    background: #25d366;
    color: #fff;
    font-size: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    z-index: 99;
}

/* ===== MODAIS ===== */
.modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0,0,0,0.5);
    display: flex;
    align-items: flex-end;
    justify-content: center;
    z-index: 200;
}
.conteudo-modal {
    background: #fff;
    width: 100%;
    max-height: 90vh;
    border-radius: 15px 15px 0 0;
    padding: 20px;
    overflow-y: auto;
}
.cabecalho-modal {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 15px;
    padding-bottom: 10px;
    border-bottom: 1px solid #eee;
}
.fechar-modal {
    background: none;
    border: none;
    font-size: 26px;
    cursor: pointer;
    color: #888;
}

/* ===== ITENS CARRINHO ===== */
.item-carrinho {
    padding: 10px 0;
    border-bottom: 1px solid #eee;
}
.nome-item { font-weight: 600; font-size: 15px; }
.detalhe-item { font-size: 13px; color: #666; margin: 3px 0; }
.total-carrinho {
    display: flex;
    justify-content: space-between;
    font-size: 18px;
    font-weight: 700;
    padding: 15px 0;
}
.btn-finalizar, .btn-adicionar {
    width: 100%;
    padding: 14px;
    background: #222;
    color: #fff;
    border: none;
    border-radius: 10px;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    margin-top: 10px;
}

/* ===== QUANTIDADE ===== */
.quantidade-produto {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    margin: 15px 0;
}
.quantidade-produto button {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid #ddd;
    background: #fff;
    font-size: 20px;
    cursor: pointer;
}
.quantidade-produto span { font-size: 20px; font-weight: 600; }

/* ===== OBSERVAÇÃO ===== */
.campo-observacao { margin: 12px 0; }
.campo-observacao label { display: block; font-weight: 500; margin-bottom: 5px; }
.campo-observacao textarea {
    width: 100%;
    border: 1px solid #ddd;
    border-radius: 8px;
    padding: 10px;
    font-size: 14px;
    resize: none;
    height: 70px;
}

/* ===== ADICIONAIS ===== */
.adicional {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 6px 0;
}
